{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.quotewise/mcp",
  "title": "Quotewise: Quotes & Quotations",
  "description": "Quote finder with 800K quotations. Find quotes by meaning, verify attributions.",
  "websiteUrl": "https://quotewise.io/",
  "icons": [
    {
      "src": "https://quotewise.io/static/brand/web/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://quotewise.io/static/brand/web/icon-192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "repository": {
    "url": "https://github.com/quotewise/mcp",
    "source": "github"
  },
  "version": "1.0.5",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.quotewise.io/",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional API key for higher rate limits. Format: Bearer YOUR_API_KEY. Anonymous access provides 20 requests/day.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
